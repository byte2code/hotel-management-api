# MySQL connection URL used by Spring Boot and Railway
DB_URL=jdbc:mysql://localhost:3306/hotel

# MySQL username for the application datasource
DB_USERNAME=demouser

# MySQL password for the application datasource
DB_PASSWORD=changeme

# Redis host for cache-backed room availability
REDIS_HOST=localhost

# Redis port for cache-backed room availability
REDIS_PORT=6379

# Keycloak client ID used by the OAuth login configuration
KEYCLOAK_CLIENT_ID=hotelDemoApplication

# Keycloak client secret for the hotel demo OAuth client
KEYCLOAK_CLIENT_SECRET=changeme

# Google OAuth client ID for social login
GOOGLE_CLIENT_ID=your-google-client-id

# Google OAuth client secret for social login
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT issuer URI used by Spring Security resource server
JWT_ISSUER_URI=https://lemur-12.cloud-iam.com/auth/realms/hotel-demo

# Keycloak auth server URL used by the legacy adapter
KEYCLOAK_AUTH_SERVER_URL=https://lemur-12.cloud-iam.com/auth
